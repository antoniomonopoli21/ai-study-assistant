DATABASE_URL=postgresql+psycopg://localhost/ai_study_assistant

# Used only by the test suite.
TEST_DATABASE_URL=postgresql+psycopg://localhost/ai_study_assistant_test

# Docker Compose local PostgreSQL settings.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ai_study_assistant

# Required: use a strong secret of at least 32 characters.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
EMBEDDING_MODEL=intfloat/multilingual-e5-small


RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_THRESHOLD=0.5
RERANKER_CANDIDATE_K=5